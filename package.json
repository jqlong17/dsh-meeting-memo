{
  "name": "dsh-meeting-memo",
  "version": "0.4.3",
  "description": "Meeting minutes in the right sidebar: local capture, transcription, and structured minutes.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "hub": {
      "summary": "把会议录音变成结构化纪要：本地转写、要点、决策与待办。"
    },
    "mobile": {
      "version": 1,
      "kind": "web",
      "title": "会议纪要",
      "path": "/dsh-meeting-memo/mobile"
    }
  },
  "scripts": {
    "build": "node ./scripts/build-host.mjs && node ./scripts/build-client.mjs",
    "build:host": "node ./scripts/build-host.mjs",
    "build:client": "node ./scripts/build-client.mjs",
    "check:client": "node --experimental-strip-types scripts/check-client.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepare": "npm run build",
    "check:mobile": "node selftest-mobile.mjs",
    "build:native": "./scripts/build-native.sh"
  },
  "files": [
    "src",
    "resources",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "meeting",
    "会议纪要",
    "notta",
    "vad",
    "sensevoice"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22.15"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqlong17/dsh-meeting-memo.git"
  },
  "homepage": "https://github.com/jqlong17/dsh-meeting-memo#readme",
  "bugs": {
    "url": "https://github.com/jqlong17/dsh-meeting-memo/issues"
  },
  "author": "ruska"
}
