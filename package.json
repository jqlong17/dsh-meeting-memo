{
  "name": "dsh-meeting-minutes",
  "version": "0.1.0",
  "description": "会议纪要 — DSH 右侧栏插件：读取 notta-input 生活日志的 VAD 分钟密度与 SenseVoice 转写，画出 06:00–24:00 当日语音密度时间轴，按区间查看转写，并用当前模型按时间线生成本地会议纪要（Markdown + JSON）。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "hub": {
      "summary": "会议纪要：当日 VAD 语音密度时间轴 + 选区 SenseVoice 转写 + AI 时间线纪要。"
    }
  },
  "scripts": {
    "build": "node ./scripts/build-host.mjs && node ./scripts/build-client.mjs",
    "build:host": "node ./scripts/build-host.mjs",
    "build:client": "node ./scripts/build-client.mjs",
    "check:client": "node ./scripts/check-client.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "meeting",
    "会议纪要",
    "notta",
    "vad",
    "sensevoice"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22.15"
  },
  "license": "MIT"
}
